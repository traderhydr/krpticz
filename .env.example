TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Price/candle data source, shared by ZENITH, GEM, KRYPTIC and RiskGuard
# (bot.py resolves this once via exchanges.resolve_source() and every engine
# uses the same fetch_klines/load_universe/fetch_funding functions).
# blofin: BloFin only, no cross-venue fallback -- every scanned symbol is
# confirmed actually listed on BloFin, and its price matches what a
# BloFin-connected Cornix account will fill at (no cross-exchange mismatch).
# binance (set here): the original Binance -> MEXC -> Bitget fallback chain
# -- matches a Cornix account executing on Binance.
DATA_SOURCE=binance

SYMBOLS=ALL
SYMBOL_DENYLIST=DOODUSDT,AKEUSDT,WLDUSDT,RAYSOLUSDT
MIN_QUOTE_VOLUME_USD=20000000
TIMEFRAME=15m
SCAN_SECONDS=90
STRATEGY_PROFILE=smc_lite
SMC_LITE=1
EXIGIR_BOS=1
EXIGIR_FVG=0
EXIGIR_POI_OR_CHOCH=1
EXIGIR_FVG_INSIDE=0
EXIGIR_CHOCH_LTF=0
EXIGIR_DESCUENTO=0
SMC_POI_SOFT=1
SMC_PD_SOFT=1
SMC_ENTRY_MODE=poi_fib
SMC_FVG_NEAR_ATR=2.20
SMC_SWING_HTF=2
SMC_SWING_LTF=2
SMC_FVG_VELAS=40
SMC_BUFFER_POI=0.25

# --- Leverage: raised to 10-15x (was 8-12x). Quality-scaled between the two
# and further clamped per-trade by LIQ_SAFETY_FRACTION so a stop-out can
# never burn more than that fraction of isolated margin.
LEVERAGE_MIN=10
LEVERAGE_MAX=15
LIQ_SAFETY_FRACTION=0.50

# --- Entry quality: MIN_SCORE raised 65->70, BTC_REGIME on by default
# (alts are BTC-beta; this vetoes counter-trend alt entries against BTC's
# prevailing 1h regime instead of only score-rewarding alignment).
MIN_SCORE=70
BTC_REGIME=1
# Reject the confirm bar if it wicks past this fraction of its range in the
# opposite direction (rejection/exhaustion), even if close/body agreed.
WICK_REJECT_MAX=0.45
# Raised from 0.45: backtest diagnostics found clean wins average ~28%
# higher confirm-bar volume than fast SL_DURING_FILL failures (price sweeps
# the whole entry ladder and stops out within the cancel window) -- weak
# confirm-bar volume correlates with immediate reversal. Turned a -1.1%
# backtested year into consistently positive on a fill-weighted basis.
VOL_MIN=0.8

ENTRY_WEIGHTS=70,10,10,10
TP_WEIGHTS=80,10,5,3,2
TP_MULTIPLES=0.2,0.5,0.95,1.5,2.3
# Shift size from TP1 toward TP2-5 as setup score rises, so the strongest
# setups hold more size into the 0.5-2.3R zone (same risk, more upside).
ADAPTIVE_TP=1

# --- Risk band tightened (was 0.95-2.20%) to offset the higher leverage
# band and cap tail-loser size — targets ~3% max drawdown together with
# RISK_EQUITY_PCT and the RiskGuard drawdown ceiling below.
R_MIN_PCT=1.00
R_MAX_PCT=1.85
SL_CAP_PCT=1.40
# Equity risked per trade, in %. This is the real drawdown lever (leverage
# mainly governs margin/liquidation headroom under risk-based sizing) — set
# your executor's (Cornix/etc.) per-trade risk to match this value.
# NOTE: raised from the repo's own 0.65 default (tuned together with
# R_MIN_PCT/R_MAX_PCT/SL_CAP_PCT below to target ~3% max DD at 0.65%) to
# match this account's real 1% Cornix risk setting -- at 1% instead of
# 0.65%, the same losing streak now swings equity ~1.54x further, so
# DD_CEILING_PCT below may trip more often than that "~3%" target assumed.
RISK_EQUITY_PCT=1.00

STOP_APRIETA=1.0
BE_AFTER_TP1=1
# Lock BE + this many R of profit (not exact breakeven) after TP1, so a
# give-back to entry still nets a small win instead of a scratch trade.
BE_BUFFER_R=0.12
CANCEL_VELAS=8
CLOSE_VELAS=20
ALLOW_SHORTS=1
LONG_ONLY=0
MAX_POSTS_PER_SCAN=2
DRY_RUN=0
LOG_REJECTS=0
SIDE_BALANCE=1

# --- Portfolio-level guardrails (risk_guard.py). The bot replays each
# posted signal forward against subsequent candles into an approximate
# equity curve; when simulated drawdown exceeds DD_CEILING_PCT it pauses
# new signals until it recovers back under DD_RESUME_PCT. Concurrency caps
# limit correlated exposure across simultaneously open signals. If the
# ceiling trips with no open trades left to organically recover it (equity
# then can't move at all), DD_PAUSE_COOLDOWN_HOURS forces a resume after
# that long regardless, resetting the high-water mark to current equity --
# otherwise the pause could last forever.
MAX_CONCURRENT_TRADES=4
MAX_CONCURRENT_SAME_SIDE=3
DD_CEILING_PCT=3.0
DD_RESUME_PCT=1.5
DD_PAUSE_COOLDOWN_HOURS=48

# =============================================================================
# GEM — second strategy engine (gem_strategy.py, ported from motor-gem.js).
# Runs in the same process/chat/RiskGuard as ZENITH above: Fibonacci-retracement
# entries (deep 79% pullback of a recent impulse leg), ATR-based stop, R-based
# quality filters, SMC (structure/FVG/order-block/liquidity-sweep) confluence
# measurements. Signals post labeled "GEM SIGNAL" instead of "ZENITH SIGNAL".
# =============================================================================
GEM_ENABLED=1
GEM_TIMEFRAME=15m
# GEM's own volume floor is typically much lower than ZENITH's -- it scans a
# separate (wider) universe, then keeps only the top GEM_TOP_N by volume.
GEM_MIN_QUOTE_VOLUME_USD=2000000
GEM_TOP_N=30
GEM_COOLDOWN_MINUTES=120
GEM_MAX_SIGNALS_PER_SCAN=3
GEM_LEVERAGE_MIN=10
GEM_LEVERAGE_MAX=10

# Every gem_strategy.GEM_CFG key is also tunable here generically as
# GEM_<KEY> (bot.py's configure_gem_strategy() applies these onto GEM_CFG,
# type-coerced from GEM_CFG's own default). Commented examples below --
# uncomment to tighten the engine beyond its original (permissive) defaults:
# GEM_MIN_SCORE=60            # 0 = accept everything (original default)
# GEM_REQUIRE_BOS=1           # only trade with a structure break in favor
# GEM_REQUIRE_HTF=1           # only trade with the (derived) 1h trend
# GEM_REQUIRE_FVG=1           # only trade with an unmitigated fair-value gap
# GEM_REQUIRE_SWEEP=1         # only trade after a liquidity sweep
# GEM_AVOID_CHOCH=1           # skip if structure just changed character
# GEM_REQUIRE_STOCH=1         # require stochastic confirmation
# GEM_R_MIN_PCT=1.5
# GEM_R_MAX_PCT=4.5
# GEM_VOL_MIN=0.5
# GEM_FUNDING_VETO=0.10
# GEM's entry/TP ladder is standardized to 4 entries / 5 TPs (same shape as
# ZENITH/KRYPTIC) -- also generically tunable as GEM_<KEY>. Entry weights set
# to match this account's real Cornix ladder split (70/10/10/10):
GEM_ENTRY_WEIGHTS=0.70,0.10,0.10,0.10
# GEM_E4_FRACTION=0.92
# GEM_TP=0.80,1.40,2.20,3.20,4.40
# GEM_CLOSES=0.35,0.25,0.20,0.12,0.08

# =============================================================================
# KRYPTIC — third strategy engine (kryptic_strategy.py, over
# entry_ladder.py/regime_filter.py/directional_bias.py/risk_manager.py).
# Runs in the same process/chat/RiskGuard as ZENITH/GEM above: a 4-tier
# scale-in entry ladder (breakout/FVG, two Fibonacci retracement tiers, a
# liquidity-sweep/ATR-band tier) gated by RegimeFilter + DirectionEngine,
# with 5 fixed ATR-multiple take-profits off the real filled VWAP. Unlike
# ZENITH/GEM, KRYPTIC's own gate is pass/fail (no continuous quality score)
# -- see kryptic_strategy.KRYPTIC_CFG["SCORE"]. Signals post labeled
# "KRYPTIC SIGNAL".
# =============================================================================
KRYPTIC_ENABLED=1
KRYPTIC_TIMEFRAME=15m
KRYPTIC_MIN_QUOTE_VOLUME_USD=20000000
KRYPTIC_TOP_N=30
KRYPTIC_COOLDOWN_MINUTES=240
KRYPTIC_MAX_SIGNALS_PER_SCAN=2
KRYPTIC_LEVERAGE_MIN=10
KRYPTIC_LEVERAGE_MAX=15

# TradeLifecycleManager geometry (risk_manager.py) -- distance of each
# target from the real filled VWAP, in ATR14.
KRYPTIC_INITIAL_SL_ATR_MULT=2.60
KRYPTIC_TP1_ATR_MULT=1.10
KRYPTIC_TP2_ATR_MULT=2.80
KRYPTIC_TP3_ATR_MULT=4.20
KRYPTIC_TP4_ATR_MULT=5.60
KRYPTIC_TP5_ATR_MULT=7.00

# Every kryptic_strategy.KRYPTIC_CFG key is also tunable here generically as
# KRYPTIC_<KEY> (bot.py's configure_kryptic_strategy() applies these):
# KRYPTIC_SCORE=75            # feeds leverage_from_quality's score-to-leverage
#                              # mapping and cross-candidate ranking only --
#                              # KRYPTIC's entry gate itself is pass/fail.
# KRYPTIC_CANCEL_BARS=8
# KRYPTIC_CLOSE_BARS=20
